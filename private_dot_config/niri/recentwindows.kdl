recent-windows {
    on
    open-delay-ms 150

    highlight {
        active-color "#999999ff"
        urgent-color "#ff9999ff"
        padding 30
        corner-radius 0
    }

    previews {
        max-height 480
        max-scale 0.25
    }

    binds {
        Ctrl+Tab         { next-window; }
        Alt+Shift+Tab   { previous-window; }
    }
}
